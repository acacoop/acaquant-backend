{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(git -C:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(./.venv/Scripts/python.exe:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(ruff check:*)",
      "Bash(pytest:*)",
      "Bash(npx tsc:*)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guardrail.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_imports.py",
            "timeout": 120,
            "statusMessage": "Validando imports (REGLA #1)…"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_agente.py",
            "timeout": 180,
            "statusMessage": "Tests del AV AGENT (REGLA #10)…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff_check.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sistema_drift.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
