[Unit]
Description=AcaQuant Asistente LangGraph Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TradingAV
ExecStart=/root/TradingAV/venv/bin/python -m asistente.worker
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
