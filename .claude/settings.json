{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(ruff check:*)",
      "Bash(pytest:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check_imports.sh",
            "if": "Bash(git push:*)",
            "timeout": 30,
            "statusMessage": "Validando imports (REGLA #1)…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff_check.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sistema_drift.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
