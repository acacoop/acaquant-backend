[Unit]
Description=Motor Ordenes - escucha order_report y persiste OrdenesLive/Audit
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/TradingAV
Environment=MOTOR_ORDENES_LOG=/root/TradingAV/logs/motor_ordenes.log
ExecStart=/root/TradingAV/venv/bin/python -m engines.motor_ordenes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
