[Unit]
Description=Motor Yield Screener ONs (main_on.py)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/TradingAV
ExecStart=/root/TradingAV/venv/bin/python /root/TradingAV/main_on.py --headless
Restart=always
RestartSec=10
StandardOutput=append:/root/TradingAV/logs/motor_on.log
StandardError=append:/root/TradingAV/logs/motor_on.log

[Install]
WantedBy=multi-user.target
