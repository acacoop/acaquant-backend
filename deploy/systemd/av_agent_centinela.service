[Unit]
Description=AV Agent Centinela - vigila precios, tasas y salud durante toda la rueda
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/TradingAV
ExecStart=/root/TradingAV/venv/bin/python -m jobs.av_agent_centinela
# A diferencia de control_saldos y tenencia_live, este NO termina al cierre: el
# sistema se puede romper a cualquier hora y el centinela es lo que se entera.
# Por eso Restart=always — si se cae, tiene que volver, siempre.
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
